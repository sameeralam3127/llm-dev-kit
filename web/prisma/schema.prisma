// Portable schema: no enums, no Json, no scalar lists — switching `provider`
// to "postgresql" / "mysql" is a one-word change with no other edits required.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Auth (Auth.js / NextAuth v5 compatible)
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  /// Null for OAuth-only users.
  passwordHash  String?
  /// "admin" | "user" | "viewer"; narrowed in lib/roles.ts. The earliest user
  /// is promoted to admin whenever no admin exists (server/identity/admin.ts).
  role          String    @default("user")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts Account[]
  sessions Session[]
  chats    Chat[]
  folders  Folder[]
  apiKeys  ApiKey[]

  @@index([email])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------------------
// Identity: the web app signs the access tokens the Python services verify
// ---------------------------------------------------------------------------

/// A personal API key (sk-ldk-...) for /v1 and the other service APIs.
model ApiKey {
  id         String    @id @default(cuid())
  userId     String
  name       String
  /// The first characters of the key, so a user can tell keys apart.
  prefix     String
  /// SHA-256 of the whole key. Keys carry 256 random bits, so a fast hash is
  /// enough; the key itself is shown once and never stored.
  hash       String    @unique
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  revokedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// An RS256 key pair the identity service signs access tokens with. The
/// public half is published at /.well-known/jwks.json; the private half is
/// encrypted with a key derived from AUTH_SECRET.
model SigningKey {
  /// The JWK "kid".
  id         String   @id
  /// Public JWK, as JSON.
  publicJwk  String
  /// Private JWK, AES-256-GCM encrypted: base64url iv.tag.ciphertext.
  privateJwk String
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Chat domain
// ---------------------------------------------------------------------------

model Folder {
  id        String   @id @default(cuid())
  name      String
  /// Tailwind-safe token from FOLDER_COLORS, not raw CSS.
  color     String   @default("slate")
  position  Int      @default(0)
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  chats Chat[]

  @@index([userId, position])
}

model Chat {
  id           String   @id @default(cuid())
  title        String   @default("New chat")
  /// Model id as understood by the provider, e.g. "llama3.1" or "openai/gpt-4o".
  model        String
  systemPrompt String?
  pinned       Boolean  @default(false)
  archived     Boolean  @default(false)
  /// Public share slug; null when the chat is private.
  shareId      String?  @unique
  sharedAt     DateTime?
  userId       String
  folderId     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  folder   Folder?   @relation(fields: [folderId], references: [id], onDelete: SetNull)
  messages Message[]

  @@index([userId, updatedAt])
  @@index([folderId])
}

model Message {
  id     String @id @default(cuid())
  chatId String
  /// "user" | "assistant" | "system" — validated by MessageRoleSchema.
  role   String
  content String
  /// Monotonic ordering within a chat; gaps are allowed.
  position Int
  /// Model that produced an assistant message.
  model    String?
  /// Set when generation failed, so the UI can offer a retry.
  error    String?
  /// Streaming was cut short (user stop / disconnect).
  truncated Boolean @default(false)
  editedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  chat     Chat             @relation(fields: [chatId], references: [id], onDelete: Cascade)
  versions MessageVersion[]

  @@index([chatId, position])
}

/// Previous contents of an assistant message, so the UI can page through
/// regenerated answers ("2 / 3") instead of losing them.
model MessageVersion {
  id        String   @id @default(cuid())
  messageId String
  content   String
  model     String?
  position  Int
  createdAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId, position])
}

/// Who did what, for admin actions. Append-only: nothing updates or deletes a
/// row (SQLite triggers installed at startup enforce it; see instrumentation.ts).
/// No foreign keys, so the history outlives the accounts it mentions. `detail`
/// is JSON text and must never hold a secret: names and prefixes only.
model AuditEvent {
  id         String   @id @default(cuid())
  at         DateTime @default(now())
  actorId    String?
  /// A snapshot, so the entry still reads correctly after an email changes.
  actorEmail String?
  /// `user.role_changed`, `api_key.revoked`, `document.uploaded`, ...
  action     String
  /// `user:<id>`, `api_key:<id>`, a filename, ...
  target     String?
  detail     String?

  @@index([at])
  @@index([action, at])
}

/// One upload from the admin console, from start to finish. Files sent straight
/// to the API (curl) bypass the web app and are not recorded here.
model IngestionJob {
  id         String    @id @default(cuid())
  /// The uploader's email, as a snapshot.
  uploadedBy String?
  filename   String
  sizeBytes  Int
  /// "running" | "succeeded" | "failed"
  status     String
  chunks     Int?
  error      String?
  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  @@index([startedAt])
}
