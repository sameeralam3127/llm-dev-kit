{
  "name": "@llm-dev-kit/web",
  "version": "1.1.0",
  "private": true,
  "description": "Production-ready AI chat application for LLM Dev Kit",
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:push": "node prisma/before-push.mjs && prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "postinstall": "prisma generate",
    "test": "vitest run",
    "bench": "vitest run --mode bench --reporter=verbose"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "2.11.3",
    "@prisma/client": "6.19.3",
    "@radix-ui/react-alert-dialog": "1.2.1",
    "@radix-ui/react-avatar": "1.3.1",
    "@radix-ui/react-collapsible": "1.2.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-label": "2.1.17",
    "@radix-ui/react-popover": "1.3.1",
    "@radix-ui/react-scroll-area": "1.4.0",
    "@radix-ui/react-select": "2.4.1",
    "@radix-ui/react-separator": "1.2.0",
    "@radix-ui/react-slot": "1.5.0",
    "@radix-ui/react-switch": "1.4.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "@radix-ui/react-visually-hidden": "1.2.13",
    "@tanstack/react-query": "5.108.2",
    "bcryptjs": "2.4.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "date-fns": "4.4.0",
    "highlight.js": "11.12.0",
    "jose": "6.2.18",
    "lucide-react": "0.577.0",
    "nanoid": "5.1.16",
    "next": "^16.4.6",
    "next-auth": "5.0.0-beta.32",
    "next-themes": "0.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "9.1.0",
    "rehype-highlight": "7.0.2",
    "remark-gfm": "4.0.1",
    "server-only": "^0.0.1",
    "sonner": "1.7.4",
    "tailwind-merge": "2.6.2",
    "tailwindcss-animate": "1.0.7",
    "zod": "^4.6.7",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@types/bcryptjs": "2.4.6",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "autoprefixer": "10.7.0",
    "eslint": "^9.39.3",
    "eslint-config-next": "^16.4.6",
    "jsdom": "30.1.3",
    "postcss": "8.5.33",
    "prisma": "6.19.3",
    "tailwindcss": "3.4.19",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.1.1"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "allowScripts": {
    "@prisma/engines@6.2.1": true,
    "esbuild@0.23.1": true,
    "sharp@0.33.5": true,
    "unrs-resolver@1.12.2": true
  },
  "overrides": {
    "postcss-selector-parser": "6.1.5"
  }
}
