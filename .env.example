# ------------------------------------------------------------ Web app (required)
# Signing key for session cookies. There is deliberately no default: a shipped
# key would let anyone forge a session on your instance. Generate one with
#
#     openssl rand -base64 32
#
# `docker compose up` refuses to start until this is set.
AUTH_SECRET=

# Public origin the app is reached on. Change if you serve it from a domain or
# a port other than the nginx gateway's 8080.
WEB_PUBLIC_URL=http://localhost:8080

# Set false to lock the instance to existing users.
ALLOW_REGISTRATION=true

# Interface the gateway (the only published port, 8080) listens on. The
# default, 127.0.0.1, keeps the stack reachable from this machine only.
# 0.0.0.0 exposes it to your network. The APIs require a signed-in session or
# an API key, but registration stays open until you set ALLOW_REGISTRATION=false.
GATEWAY_BIND=127.0.0.1

# ---------------------------------------------------------------- Authentication
# Every API call needs a credential: the browser's session, or a personal API
# key (account menu → API keys) as "Authorization: Bearer sk-ldk-...". The first
# account registered becomes the admin.
#
# true restores the pre-v2 behaviour for one release: calls without a
# credential get full access, logged as a warning each time. See
# docs/v2/MIGRATION.md before turning it on.
ALLOW_LEGACY_ANONYMOUS=false

# For the mcp profile: the API key the MCP tools act as.
LDK_API_KEY=

# ------------------------------------------------- Single sign-on (sso profile)
# `docker compose --profile sso up` runs Keycloak at <WEB_PUBLIC_URL>/sso with a
# ready llm-dev-kit realm. Set the first two before its first start:
#   KEYCLOAK_ADMIN_PASSWORD  admin console (user "admin") at <WEB_PUBLIC_URL>/sso/admin
#   AUTH_KEYCLOAK_SECRET     shared by Keycloak and this app: openssl rand -hex 32
# then these two to show "Continue with single sign-on" on the sign-in page:
#   AUTH_KEYCLOAK_ID=llm-dev-kit-web
#   AUTH_KEYCLOAK_ISSUER=<WEB_PUBLIC_URL>/sso/realms/llm-dev-kit
# Create people in the Keycloak admin console. Each gets an account here on
# first sign-in, with the "user" role. An email that already has a local
# account is refused rather than linked.
KEYCLOAK_ADMIN_PASSWORD=
AUTH_KEYCLOAK_SECRET=
AUTH_KEYCLOAK_ID=
AUTH_KEYCLOAK_ISSUER=
# Optional: also accept Keycloak's own access tokens on /v1 and the APIs.
# AUTH_OIDC_ISSUER=http://localhost:8080/sso/realms/llm-dev-kit
# AUTH_OIDC_DISCOVERY_URL=http://keycloak:8080/sso/realms/llm-dev-kit/.well-known/openid-configuration

# ------------------------------------------------------------------ Offline LLM
# Host Ollama is the default: the containers reach it through host.docker.internal.
# To run the services outside Docker (npm run dev, python -m ...), set
# OLLAMA_HOST=http://localhost:11434 instead. For the ollama compose profile,
# use OLLAMA_HOST=http://ollama:11434.
OLLAMA_HOST=http://host.docker.internal:11434
DEFAULT_CHAT_MODEL=llama3.1
DEFAULT_EMBEDDING_MODEL=nomic-embed-text
# Vector length of the embedding model. Needed only for models llm-service does
# not already know (nomic-embed-text, mxbai-embed-large, bge-m3, all-minilm,
# snowflake-arctic-embed); an unknown model without it stops startup.
# EMBEDDING_DIMENSION=
REQUEST_TIMEOUT_SECONDS=120

# --------------------------------------------------- Cloud providers (optional)
# Leave empty for a fully offline stack. Cloud calls are routed through
# LiteLLM; models are addressed as "openai/<model>", "gemini/<model>" and
# "anthropic/<model>". API callers may also send a key per request (`api_key`
# in the body, or a Bearer token on /v1); the web app uses these server keys. OPENAI_BASE_URL may point at any
# OpenAI-compatible API (Groq, Together, vLLM, ...).
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com

# ------------------------------------------------ Service URLs (local dev only)
# Inside docker compose these are set per service; override when running a
# service directly on your machine.
LLM_SERVICE_URL=http://localhost:8010
RAG_SERVICE_URL=http://localhost:8020

# ----------------------------------------------------------------------- Cache
REDIS_URL=redis://localhost:6379/0
CACHE_TTL=3600

# ---------------------------------------------------------------- Vector store
CHROMA_HOST=localhost
CHROMA_PORT=8000

# --------------------------------------------------------------------- Logging
# Python services log one JSON object per line, each carrying the request id
# (X-Request-ID). Use LOG_FORMAT=console for human-readable local output.
LOG_LEVEL=INFO
LOG_FORMAT=json

# Optional: a link to Grafana (or any dashboard) on the admin health page.
# GRAFANA_URL=http://localhost:3001
