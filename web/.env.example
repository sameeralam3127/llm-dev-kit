# ---------------------------------------------------------------------------
# Database
# SQLite by default — zero setup, file-backed, survives restarts.
# For Postgres: set the URL below AND change `provider` in prisma/schema.prisma.
# ---------------------------------------------------------------------------
DATABASE_URL="file:./dev.db"

# ---------------------------------------------------------------------------
# Auth — REQUIRED. Generate with: openssl rand -base64 32
# ---------------------------------------------------------------------------
AUTH_SECRET="replace-me-with-at-least-32-random-characters"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST=true

# Optional GitHub OAuth. Both must be set for the button to appear.
# AUTH_GITHUB_ID=""
# AUTH_GITHUB_SECRET=""

# Set false to lock the instance to existing users.
ALLOW_REGISTRATION=true

# ---------------------------------------------------------------------------
# Model backend — any OpenAI-compatible /v1 endpoint.
#
#   through the nginx gateway :  http://localhost:8080/api/rag/v1
#   rag-service directly      :  http://localhost:8020/v1
#   ollama directly           :  http://localhost:11434/v1
#
# rag-service ignores keys starting with "sk-local" and stays fully offline;
# a real key is forwarded upstream for cloud models.
# ---------------------------------------------------------------------------
LLM_BASE_URL="http://localhost:8020/v1"
LLM_API_KEY="sk-local"
DEFAULT_MODEL="llama3.1"
LLM_REQUEST_TIMEOUT_MS=120000
